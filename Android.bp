android_app_import {
    name: "WiFiManager",
    apk: "app-debug.apk",
    presigned: true,
    preprocessed: true,
    dex_preopt: {
        enabled: false,
    },
    required: ["default-permissions-wifimanager.xml"],
}

prebuilt_etc {
    name: "default-permissions-wifimanager.xml",
    src: "etc/default-permissions/default-permissions-wifimanager.xml",
    sub_dir: "default-permissions",
    filename_from_src: true,
}

