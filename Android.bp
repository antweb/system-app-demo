android_app {
    name: "WiFiManager",
    srcs: ["app/src/main/java/**/*.kt"],
    resource_dirs: ["app/src/main/res"],
    manifest: "app/src/main/AndroidManifest.xml",
    platform_apis: true,
    privileged: true,
    optimize: {
        enabled: false,
    },
    static_libs: [
        "androidx.core_core-ktx",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.lifecycle_lifecycle-viewmodel-compose",
        "androidx.activity_activity-compose",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-graphics",
        "androidx.compose.material3_material3",
    ],
    required: ["default-permissions-wifimanager.xml"],
}

prebuilt_etc {
    name: "default-permissions-wifimanager.xml",
    src: "etc/default-permissions/default-permissions-wifimanager.xml",
    sub_dir: "default-permissions",
    filename_from_src: true,
}


